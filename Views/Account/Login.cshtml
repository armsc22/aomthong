@model LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบสมาชิก";
}

<section class="section">
    <div class="container container--narrow">
        <div class="account-card">
            <div class="account-card__head">
                <img src="~/img/logo.png" alt="" width="56" height="56" />
                <div>
                    <h1>เข้าสู่ระบบสมาชิก</h1>
                    <p>ใช้เบอร์โทรศัพท์และ PIN 6 หลัก</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <p class="form-error">@Model.Error</p>
            }

            <form asp-controller="Account" asp-action="Login" method="post" class="account-form">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />
                <label for="phone">เบอร์โทรศัพท์</label>
                <input class="field" id="phone" name="Phone" value="@Model.Phone" autocomplete="username" inputmode="tel" required />
                <label for="pin">PIN 6 หลัก</label>
                <input class="field" id="pin" name="Pin" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="current-password" required />
                <button class="btn-gold" type="submit">เข้าสู่ระบบ</button>
            </form>

            <p class="account-card__hint">
                ยังไม่มีบัญชี? <a asp-controller="Account" asp-action="Register">สมัครสมาชิกผ่านบัญชี LINE</a>
            </p>
            <p class="account-card__hint">
สมาชิกเดิมที่ยังไม่มี PIN หรือลืม PIN กรุณาติดต่อผู้ดูแลร้านเพื่อยืนยันตัวตนและตั้ง PIN ใหม่ หากกรอกผิด 5 ครั้ง บัญชีจะพัก 15 นาที</p>
        </div>
    </div>
</section>

