@model IReadOnlyList<CustomerBalance>
@inject ShopSettings Shop
@{
    ViewData["Title"] = "รายชื่อลูกค้าทั้งหมด";
    var rate = Shop.SavingsAnnualDividendPercent;
    var totalDeposit = Model.Sum(row => row.DepositBalance);
    var totalDividend = Model.Sum(row => SavingsRules.DailyDividend(row.DepositBalance, rate));
    var number = 0;
}

<section class="customers-page">
    @if (TempData["PinMessage"] is string message) { <p role="status">@message</p> }
    <div class="customers-heading">
        <div>
            <h1>รายชื่อลูกค้าทั้งหมด</h1>
            <p>สมาชิกทั้งหมด @Model.Count ราย</p>
        </div>
        <a class="bottom-button" asp-area="Admin" asp-controller="Deposit" asp-action="Index">กลับหน้าฝาก–ถอน</a>
    </div>
    <div class="table-card">
        <div class="table-wrap" tabindex="0" role="region" aria-label="ตารางรายชื่อลูกค้าทั้งหมด">
            <table class="customers-table">
                <caption>ยอดเงินฝากคงเหลือและปันผลประมาณการต่อวัน (บาท)</caption>
                <thead>
                    <tr>
                        <th scope="col">ที่</th>
                        <th scope="col">เลขที่ Member Code</th>
                        <th scope="col">เลขที่สัญญา</th>
                        <th scope="col">ชื่อ-นามสกุล</th>
                        <th scope="col">จำนวนเงินฝาก</th>
                        <th scope="col">ปันผล @rate.ToString("0.0")%/ปี<br /><small>จำนวนเงินต่อวัน</small></th>
                        <th scope="col">รวมเงิน<br /><small>เงินฝาก + ปันผลหนึ่งวัน</small></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var dividend = SavingsRules.DailyDividend(row.DepositBalance, rate);
                        <tr>
                            <td>@(++number)</td>
                            <td>@row.MemberCode</td>
                            <td>@(string.IsNullOrEmpty(row.ContractNumber) ? "—" : row.ContractNumber)</td>
                            <td class="customer-name">@row.FullName
                                <div class="customer-actions">
                                    <a asp-area="" asp-controller="MemberDocuments" asp-action="Index" asp-route-customerId="@row.CustomerId">เอกสารสมัคร / บัญชีธนาคาร</a>
                                    <a asp-area="Admin" asp-controller="Customers" asp-action="Pin" asp-route-customerId="@row.CustomerId">ตั้ง / รีเซ็ต PIN</a>
                                    <a asp-area="Admin" asp-controller="Sales" asp-action="Create" asp-route-customerId="@row.CustomerId">รายการซื้อเงินสด</a>
                                    <a asp-area="Admin" asp-controller="DepositReceipts" asp-action="Preview" asp-route-customerId="@row.CustomerId">ตัวอย่างใบรับเงินมัดจำ</a>
                                </div>
                            </td>
                            <td class="money">@row.DepositBalance.ToString("N2")</td>
                            <td class="money">@dividend.ToString("N4")</td>
                            <td class="money">@((row.DepositBalance + dividend).ToString("N4"))</td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="customers-empty">ยังไม่มีลูกค้าในระบบ</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row" colspan="4">รวมทั้งหมด</th>
                        <td class="money">@totalDeposit.ToString("N2")</td>
                        <td class="money">@totalDividend.ToString("N4")</td>
                        <td class="money">@((totalDeposit + totalDividend).ToString("N4"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="customers-notes">
        <p>ปันผลต่อวัน = เงินฝากคงเหลือ × @rate.ToString("0.0")% ÷ 365 เช่น เงินฝาก 1,000 บาท ได้ปันผล @SavingsRules.DailyDividend(1000m, rate).ToString("N4") บาทต่อวัน</p>
        <p>เลขที่สัญญาใช้เลขบัญชีออมทอง เงินฝากคงเหลือรวมดอกเบี้ยที่ลงบัญชีแล้วและหักยอดถอนแล้ว</p>
        <p>ปันผลและรวมเงินในตารางเป็นยอดประมาณการ ปัดทศนิยม 4 ตำแหน่ง ยังไม่ได้บันทึกปันผลเพิ่มเข้าบัญชี</p>
    </div>
</section>
